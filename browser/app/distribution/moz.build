DIST_SUBDIR = ""

# Install Plezix's default extension from Mozilla Add-ons. Keep this outside
# BUILT_BY_MOZILLA so local and developer builds receive the same policy.
FINAL_TARGET_FILES.distribution += [
    "policies.json",
]

if CONFIG["BUILT_BY_MOZILLA"]:
    FINAL_TARGET_FILES.distribution += [
        "distribution.ini",
    ]
